// Review fixture: platform, monitor, and Python scope transitions.
using "platforms/cpus/example.repl"

sysbus:
    init:
        echo "monitor command inside platform init"
        Tag <0x1000 4> "review" // Platform comment outside the monitor injection.
        python """
values = {"nested": 42}
for name, value in values.items():
    print(name, value)
"""
    reset add:
        echo "monitor block ends before the next platform entry"

device: Python.PythonPeripheral @ sysbus 0x2000
    script: '''
def on_read(request):
    return 42 if request.IsRead else 0
'''
    size: 0x100

explicit: Example.Device @ { sysbus 0x4000; sysbus 0x5000 } {
    init: { echo "monitor command inside braces" };
    reset: { echo "reset inside braces" }
}

after: Memory.MappedMemory @ sysbus 0x6000
    size: 0x100
